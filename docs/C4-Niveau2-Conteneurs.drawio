<mxfile host="app.diagrams.net" type="device">
  <diagram name="C4 Niveau 2 - Conteneurs" id="c4-level2">
    <mxGraphModel dx="1422" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="PLAYZONE — Diagramme de conteneurs (C4 niveau 2)" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0a0e1a;" vertex="1" parent="1">
          <mxGeometry x="220" y="20" width="730" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Décomposition du système PLAYZONE en conteneurs déployables et leurs interactions" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#5F5F5F;" vertex="1" parent="1">
          <mxGeometry x="220" y="56" width="730" height="24" as="geometry" />
        </mxCell>

        <!-- Acteurs -->
        <mxCell id="visiteur" value="&lt;b&gt;Visiteur&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#dfe7f5&quot;&gt;[Personne]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Consulte les fils&lt;br&gt;sans être connecté." style="rounded=8;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#062f57;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="120" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="user" value="&lt;b&gt;Utilisateur authentifié&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#dfe7f5&quot;&gt;[Personne]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Crée des fils, poste,&lt;br&gt;réagit aux messages." style="rounded=8;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#062f57;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="500" y="120" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="&lt;b&gt;Administrateur&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#dfe7f5&quot;&gt;[Personne]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Modère, gère les états,&lt;br&gt;bannit les comptes." style="rounded=8;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#062f57;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="120" width="170" height="90" as="geometry" />
        </mxCell>

        <!-- Frontière du système -->
        <mxCell id="boundary" value="Système PLAYZONE" style="rounded=12;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#7c3aed;dashed=1;dashPattern=8 6;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingTop=10;spacingLeft=16;fontColor=#7c3aed;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="140" y="300" width="900" height="470" as="geometry" />
        </mxCell>

        <!-- Conteneur Navigateur -->
        <mxCell id="browser" value="&lt;b&gt;Navigateur Web&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#d6e4f5&quot;&gt;[Conteneur : HTML / CSS / JS]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Affiche les pages du forum, gère la navigation et soumet les formulaires de l'utilisateur." style="rounded=8;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="470" y="350" width="240" height="110" as="geometry" />
        </mxCell>

        <!-- Conteneur Application Web Go -->
        <mxCell id="webapp" value="&lt;b&gt;Application Web&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#d6e4f5&quot;&gt;[Conteneur : Golang + go-chi + html/template]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Gère les routes HTTP, l'authentification JWT, la logique métier (fils, messages, réactions, modération) et le rendu des pages HTML.&lt;br&gt;&lt;br&gt;Architecture MVC en couches : Router → Controller → Service → Repository." style="rounded=8;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="560" width="320" height="170" as="geometry" />
        </mxCell>

        <!-- Conteneur Base de données -->
        <mxCell id="db" value="&lt;b&gt;Base de données&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#d6e4f5&quot;&gt;[Conteneur : SQLite]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Stocke les utilisateurs, catégories, tags, fils, messages et réactions.&lt;br&gt;Base relationnelle (fichier .db)." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="560" width="250" height="170" as="geometry" />
        </mxCell>

        <!-- Relations acteurs -> navigateur -->
        <mxCell id="r-vis" value="Consulte le forum&#xa;[HTTPS]" style="endArrow=blockThin;html=1;rounded=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="visiteur" target="browser">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r-usr" value="Discute, réagit&#xa;[HTTPS]" style="endArrow=blockThin;html=1;rounded=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="user" target="browser">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r-adm" value="Modère&#xa;[HTTPS]" style="endArrow=blockThin;html=1;rounded=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="admin" target="browser">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Navigateur <-> App -->
        <mxCell id="r-bw" value="Envoie les requêtes&#xa;[HTTPS, formulaires, cookie JWT]" style="endArrow=blockThin;html=1;rounded=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;fontColor=#333333;exitX=0.4;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="browser" target="webapp">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="r-wb" value="Renvoie les pages HTML&#xa;[HTTPS]" style="endArrow=blockThin;html=1;rounded=1;endFill=1;dashed=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#888888;fontSize=10;fontColor=#555555;exitX=0.7;exitY=0;entryX=0.65;entryY=1;" edge="1" parent="1" source="webapp" target="browser">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- App <-> BDD -->
        <mxCell id="r-db" value="Lit / écrit les données&#xa;[SQL via database/sql]" style="endArrow=blockThin;html=1;rounded=1;endFill=1;edgeStyle=orthogonalEdgeStyle;strokeColor=#555555;fontSize=10;fontColor=#333333;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="webapp" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Légende -->
        <mxCell id="legend" value="&lt;b&gt;Légende&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#08427b&quot;&gt;■&lt;/font&gt; Personne (acteur)&lt;br&gt;&lt;font color=&quot;#438dd5&quot;&gt;■&lt;/font&gt; Conteneur (application / BDD)&lt;br&gt;&lt;font color=&quot;#7c3aed&quot;&gt;┄┄&lt;/font&gt; Frontière du système&lt;br&gt;──► Flux de données&lt;br&gt;┄┄► Réponse / rendu HTML" style="rounded=8;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f7f7fb;strokeColor=#999999;fontSize=11;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="160" y="350" width="270" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
