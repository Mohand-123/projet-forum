        </mxCell>
        <mxCell id="boundary" value="Système PLAYZONE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="200" y="430" width="800" height="350" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="&lt;b&gt;Navigateur Web&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ffffff80&quot;&gt;[Conteneur : HTML / CSS / JS]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Affiche les pages du forum à l'utilisateur, gère la navigation et soumet les formulaires." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="250" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="webapp" value="&lt;b&gt;Application Web&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ffffff80&quot;&gt;[Conteneur : Golang + go-chi + html/template]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Gère les routes HTTP, l'authentification JWT, la logique métier et le rendu des pages HTML." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="500" width="320" height="140" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;Base de données&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ffffff80&quot;&gt;[Conteneur : SQLite]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Stocke les utilisateurs, fils, messages, réactions, catégories et tags." style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="660" y="500" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="Visite les pages&#xa;[HTTPS]" style="endArrow=blockThin;html=1;rounded=0;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#666666;fontSize=11;fontColor=#444444;" edge="1" parent="1" source="user2" target="browser">
          <mxGeometry relative="1" as="geometry" />
