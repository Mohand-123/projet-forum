          <mxGeometry x="280" y="20" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle-3" value="Architecture MVC en couches de l'application Go" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#5F5F5F;" vertex="1" parent="1">
          <mxGeometry x="280" y="60" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="browser3" value="&lt;b&gt;Navigateur Web&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ffffff80&quot;&gt;[Conteneur]&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#2e6295;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=12;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="480" y="110" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="boundary3" value="Application Web Go (Conteneur)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;fontSize=13;fontStyle=1;verticalAlign=top;align=left;spacingTop=8;spacingLeft=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="1020" height="510" as="geometry" />
        </mxCell>
        <mxCell id="router" value="&lt;b&gt;Router&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ffffff80&quot;&gt;[Composant : go-chi]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Définit toutes les URLs et applique les middlewares." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#5d82a8;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="260" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="middleware" value="&lt;b&gt;Middleware JWT&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ffffff80&quot;&gt;[Composant]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Vérifie le token JWT et le rôle admin." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#5d82a8;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="780" y="260" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="controllers" value="&lt;b&gt;Controllers&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ffffff80&quot;&gt;[Composant : HTTP handlers]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Auth, Home, Thread, Message, Reaction, Admin.&lt;br&gt;Reçoit les requêtes et valide les entrées." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#5d82a8;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="380" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="services" value="&lt;b&gt;Services&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ffffff80&quot;&gt;[Composant : logique métier]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Auth (SHA-512, JWT), Thread, Message, Reaction, Admin.&lt;br&gt;Applique les règles du forum." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#5d82a8;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="510" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="repos" value="&lt;b&gt;Repositories&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ffffff80&quot;&gt;[Composant : accès BDD]&lt;/font&gt;&lt;br&gt;&lt;br&gt;User, Thread, Message, Reaction, Tag.&lt;br&gt;Encapsule les requêtes SQL." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#5d82a8;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="640" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="views" value="&lt;b&gt;Views&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ffffff80&quot;&gt;[Composant : html/template]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Layout, Home, Login, Register, Thread, Admin…&lt;br&gt;Rend les pages HTML côté serveur." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#85bbf0;strokeColor=#5d82a8;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="110" y="380" width="280" height="100" as="geometry" />
        </mxCell>
