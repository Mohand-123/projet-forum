  <diagram name="C4 Niveau 1 - Contexte" id="c4-context">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title-1" value="C4 — Niveau 1 : Diagramme de contexte" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1F1F1F;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle-1" value="Vue d'ensemble de PLAYZONE et de ses utilisateurs" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#5F5F5F;" vertex="1" parent="1">
          <mxGeometry x="280" y="60" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="visiteur" value="&lt;b&gt;Visiteur&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ffffff80&quot;&gt;[Personne]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Internaute non connecté qui consulte le site." style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontColor=#FFFFFF;fillColor=#08427b;strokeColor=#08427b;align=center;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="60" height="100" as="geometry" />
        </mxCell>
        <mxCell id="utilisateur" value="&lt;b&gt;Utilisateur authentifié&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ffffff80&quot;&gt;[Personne]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Joueur inscrit qui crée des fils et discute." style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontColor=#FFFFFF;fillColor=#08427b;strokeColor=#08427b;align=center;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="200" width="60" height="100" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="&lt;b&gt;Administrateur&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ffffff80&quot;&gt;[Personne]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Modérateur qui gère la plateforme." style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontColor=#FFFFFF;fillColor=#08427b;strokeColor=#08427b;align=center;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="200" width="60" height="100" as="geometry" />
        </mxCell>
        <mxCell id="playzone" value="&lt;b&gt;PLAYZONE&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ffffff80&quot;&gt;[Système logiciel]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Forum communautaire en ligne dédié aux gamers et à l'esport. Permet de créer des fils de discussion, poster des messages, réagir et modérer la communauté." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#FFFFFF;align=center;verticalAlign=middle;fontSize=13;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="500" width="300" height="160" as="geometry" />
        </mxCell>
        <mxCell id="rel1" value="Consulte les fils&#xa;[HTTPS]" style="endArrow=blockThin;html=1;rounded=0;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;strokeColor=#666666;fontSize=11;fontColor=#444444;" edge="1" parent="1" source="visiteur" target="playzone">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel2" value="Discute, réagit&#xa;[HTTPS]" style="endArrow=blockThin;html=1;rounded=0;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#666666;fontSize=11;fontColor=#444444;" edge="1" parent="1" source="utilisateur" target="playzone">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rel3" value="Modère, bannit&#xa;[HTTPS]" style="endArrow=blockThin;html=1;rounded=0;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;strokeColor=#666666;fontSize=11;fontColor=#444444;" edge="1" parent="1" source="admin" target="playzone">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="legend-1" value="&lt;b&gt;Légende&lt;/b&gt;&lt;br&gt;━━━━━&lt;br&gt;&lt;font color=&quot;#08427b&quot;&gt;■&lt;/font&gt; Personne (acteur)&lt;br&gt;&lt;font color=&quot;#1168bd&quot;&gt;■&lt;/font&gt; Système PLAYZONE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="220" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="C4 Niveau 2 - Conteneurs" id="c4-containers">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
