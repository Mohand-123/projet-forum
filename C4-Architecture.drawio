          <mxGeometry x="280" y="20" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle-2" value="Décomposition de PLAYZONE en applications déployables" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#5F5F5F;" vertex="1" parent="1">
          <mxGeometry x="280" y="60" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="user2" value="&lt;b&gt;Utilisateur&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ffffff80&quot;&gt;[Personne]&lt;/font&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;fontColor=#FFFFFF;fillColor=#08427b;strokeColor=#08427b;align=center;spacingTop=10;" vertex="1" parent="1">
